# ══════════════════════════════════════════════════════════
#  Zone Bot — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git (it's in .gitignore).
# ══════════════════════════════════════════════════════════

# ── MT5 Account Credentials ───────────────────────────────
# Your MT5 login number (integer)
TRADING_ID=123456

# Your MT5 account password
MT5_PASSWORD=YourBrokerPassword

# Your broker's MT5 server name (shown in MT5 login dialog)
# Example: HFMarketsKE-Demo02  or  ICMarkets-Demo
MT5_SERVER=YourBroker-ServerName

# ── VNC Access (for the browser-based MT5 UI) ─────────────
# Set any username and a strong password for the noVNC login
VNC_USER=admin
VNC_PASSWORD=changeme

# ── Broker / Account Type ────────────────────────────────
# Controls how trading costs (spread + commission) are calculated.
# Set BROKER_ACCOUNT_TYPE to one of the values below.
#
# HFM accounts:
#   ZERO_SPREAD    — HFM Zero Spread: raw spread ≈ 0 pips + $3/lot commission (majors), $5/lot (Gold)
#   PREMIUM        — HFM Premium: spread-based (~1.4+ pips EURUSD), no commission
#   PRO            — HFM Pro: spread-based (~0.5+ pips EURUSD), no commission
#
# IC Markets accounts:
#   IC_MARKETS_RAW — IC Markets Raw Spread: ECN spread (~0.1 pips EURUSD) + $3.50/lot/side commission
#
# ── TO SWITCH TO IC MARKETS ───────────────────────────────
# 1. Change BROKER_ACCOUNT_TYPE to IC_MARKETS_RAW
# 2. Change MT5_SERVER to your IC Markets server name (e.g. ICMarkets-Live01 or ICMarkets-Demo)
# 3. Change TRADING_ID and MT5_PASSWORD to your IC Markets account credentials
# 4. Optionally override the per-lot commission if IC Markets changes their rate:
#    IC_COMMISSION_PER_LOT_USD=3.50
# ---------------------------------------------------------
BROKER_ACCOUNT_TYPE=ZERO_SPREAD

# Legacy alias — accepted for backwards compatibility. Use BROKER_ACCOUNT_TYPE instead.
# HFM_ACCOUNT_TYPE=ZERO_SPREAD

# IC Markets commission rate override (USD per lot per side).
# Default is 3.50 — only set this if IC Markets changes their fee structure.
# IC_COMMISSION_PER_LOT_USD=3.50

# ── News API ──────────────────────────────────────────────
# ForexFactory/MyFxBook API key — leave blank to skip news filtering
NEWS_API_KEY=
# URL of the forex-api container — uses Docker service name so it resolves inside the shared network
NEWS_API_URL=http://forex-api:8000
